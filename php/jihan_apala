    }

    // mencari Principe Eigen Vector (λ maks)
    function getEigenVector($matrik_a, $n)
    {
        $eigenvektor = [];
        for ($i = 0; $i < $n; $i++) {
            $sum = 0;
            for ($j = 0; $j < $n; $j++) {
                $sum += $matrik_a[$i][$j];
            }
            $eigenvektor[$i] = $sum / $n; // Rata-rata
        }
        echo "Eigen Vector: " . implode(", ", $eigenvektor) . "<br>";
        return $eigenvektor;
    }

    // mencari Cons Index
    function getConsIndex($matrik_a, $n)
    {
        $lambda_max = getEigenVector($matrik_a, $n); // Ambil nilai eigen maksimum
        $consindex = ($lambda_max - $n) / ($n - 1);
        echo "Consistency Index (CI): $consindex<br>";
        return $consindex;
    }

    // mencari Consistency Ratio
    function getConsRatio($matrik_a, $matrik_b, $n)
    {
        $consindex = getConsIndex($matrik_a, $matrik_b, $n);
        $nilaiIR = getNilaiIR($n);

        // Debugging: Cetak nilai yang digunakan
        echo "Eigen Vector: " . getEigenVector($matrik_a, $matrik_b, $n) . "<br>";
        echo "Consistency Index (CI): " . $consindex . "<br>";
        echo "Random Index (IR): " . $nilaiIR . "<br>";

        // Pastikan nilai IR tidak nol untuk menghindari pembagian dengan nol
        if ($nilaiIR == 0) {
            echo "Error: Random Index (IR) tidak valid.";
            return null; // atau nilai default
        }

        $consratio = $consindex / $nilaiIR;

        return $consratio;
    }


